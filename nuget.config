<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <!-- The SDK of the server this builds for: pack.ps1 fills the folder from that server's sdk/. -->
    <add key="oblivion-sdk" value=".sdk" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="oblivion-sdk">
      <package pattern="ReadyM.SDK.*" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
