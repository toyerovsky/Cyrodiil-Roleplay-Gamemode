root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 4

[*.{js,mjs,vue,css,html,json,yml,yaml}]
indent_size = 2

[*.cs]
dotnet_diagnostic.IDE0005.severity = warning

[src/CyrodiilRP.Data/Migrations/*.cs]
generated_code = true
dotnet_diagnostic.IDE0005.severity = none
