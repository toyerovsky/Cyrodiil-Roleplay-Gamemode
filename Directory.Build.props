<Project>

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <LangVersion>latest</LangVersion>
        <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
        <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
        <!-- Needed for IDE0005 (unused usings) to run in the build. No XML doc comments are required. -->
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <!-- CS8524: a switch naming every member of an enum still warns about values outside it, which throw. -->
        <NoWarn>$(NoWarn);CS1591;CS1573;CS1572;CS8524</NoWarn>
        <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    </PropertyGroup>

    <!-- The SDK is the server's own: pack.ps1 copies the packages from the sdk/ folder of the server it builds for into .sdk/ (nuget.config's source), so the mod always compiles against what that server loads. The version is theirs. -->
    <PropertyGroup>
        <OblivionSdkFeed>$(MSBuildThisFileDirectory).sdk</OblivionSdkFeed>
        <OblivionSdkPackage>$([System.IO.Directory]::GetFiles('$(OblivionSdkFeed)', 'ReadyM.SDK.Oblivion.Common.*.nupkg'))</OblivionSdkPackage>
        <OblivionSdkVersion Condition="'$(OblivionSdkPackage)' != ''">$([System.IO.Path]::GetFileNameWithoutExtension('$(OblivionSdkPackage)').Replace('ReadyM.SDK.Oblivion.Common.', ''))</OblivionSdkVersion>
    </PropertyGroup>

    <Target Name="CheckOblivionSdk" BeforeTargets="Restore;Build" Condition="'$(OblivionSdkVersion)' == ''">
        <ItemGroup>
            <OblivionSdkReference Include="@(PackageReference)" Condition="$([System.String]::Copy('%(Identity)').StartsWith('ReadyM.SDK.Oblivion'))" />
        </ItemGroup>
        <Error Condition="'@(OblivionSdkReference)' != ''"
               Text="No SDK in .sdk/: run ./pack.ps1 -PackOnly, which takes it from the server (see DEVELOPMENT.md)." />
    </Target>

</Project>
