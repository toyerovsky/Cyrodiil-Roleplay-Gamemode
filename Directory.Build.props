<Project>

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <LangVersion>latest</LangVersion>
        <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
        <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
        <!-- Needed for IDE0005 (unused usings) to run in the build. No XML doc comments are required. -->
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <!-- CS8524: a switch naming every member of an enum still warns about values outside it, which throw. -->
        <NoWarn>$(NoWarn);CS1591;CS1573;CS1572;CS8524</NoWarn>
        <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    </PropertyGroup>

    <!-- The SDK from an oblivion-mod checkout on rp-framework (the Roleplay mods need it, see mods/README.md): the folder next to this repository, or -p:OblivionModRoot=... -->
    <PropertyGroup>
        <OblivionModRoot Condition="'$(OblivionModRoot)' == ''">$(OBLIVION_MOD_ROOT)</OblivionModRoot>
        <OblivionModRoot Condition="'$(OblivionModRoot)' == ''">$(MSBuildThisFileDirectory)..\oblivion-mod\</OblivionModRoot>
        <OblivionModRoot>$([MSBuild]::EnsureTrailingSlash('$(OblivionModRoot)'))</OblivionModRoot>
        <CoreSdkSrc>$(OblivionModRoot)readym-gameserver\src\readym-core-sdk\src\</CoreSdkSrc>
        <HungerModRoot>$(MSBuildThisFileDirectory)mods\HungerAndThirst\</HungerModRoot>
    </PropertyGroup>

</Project>
