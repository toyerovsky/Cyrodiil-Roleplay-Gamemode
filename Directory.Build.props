<Project>

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <LangVersion>latest</LangVersion>
        <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
        <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
        <!-- Needed for IDE0005 (unused usings) to run in the build. No XML doc comments are required. -->
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <!-- CS8524: a switch naming every member of an enum still warns about values outside it, which throw. -->
        <NoWarn>$(NoWarn);CS1591;CS1573;CS1572;CS8524</NoWarn>
        <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    </PropertyGroup>

    <!-- The SDK is the packages of .sdk/ (nuget.config's source), kept in Git LFS. The version is theirs. pack.ps1 refuses a server built with another one. -->
    <PropertyGroup>
        <OblivionSdkFeed>$(MSBuildThisFileDirectory).sdk</OblivionSdkFeed>
        <OblivionSdkPackage>$([System.IO.Directory]::GetFiles('$(OblivionSdkFeed)', 'ReadyM.SDK.Oblivion.Common.*.nupkg'))</OblivionSdkPackage>
        <OblivionSdkVersion Condition="'$(OblivionSdkPackage)' != ''">$([System.IO.Path]::GetFileNameWithoutExtension('$(OblivionSdkPackage)').Replace('ReadyM.SDK.Oblivion.Common.', ''))</OblivionSdkVersion>
    </PropertyGroup>

    <Target Name="CheckOblivionSdk" BeforeTargets="Restore;Build" Condition="'$(OblivionSdkVersion)' == ''">
        <ItemGroup>
            <OblivionSdkReference Include="@(PackageReference)" Condition="$([System.String]::Copy('%(Identity)').StartsWith('ReadyM.SDK.Oblivion'))" />
        </ItemGroup>
        <Error Condition="'@(OblivionSdkReference)' != ''"
               Text="No SDK in .sdk/: its packages come with the repository through Git LFS, run git lfs pull (see DEVELOPMENT.md)." />
    </Target>

    <!-- A clone made without Git LFS has a few lines of text in place of each package, which NuGet reports as a broken archive. -->
    <Target Name="CheckOblivionSdkFetched" BeforeTargets="CollectPackageReferences;Restore;Build" Condition="'$(OblivionSdkPackage)' != ''">
        <Error Condition="$([System.IO.File]::ReadAllText('$(OblivionSdkPackage)').StartsWith('version https://git-lfs'))"
               Text="The SDK packages in .sdk/ are Git LFS pointers: run git lfs install, then git lfs pull (see DEVELOPMENT.md)." />
    </Target>

</Project>
