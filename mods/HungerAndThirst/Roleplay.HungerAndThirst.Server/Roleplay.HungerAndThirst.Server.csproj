<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
    </PropertyGroup>

    <!-- The relay-server SDK, from the local oblivion-mod (see Directory.Build.props). The server
         provides these assemblies at runtime, so they never end up in your mod folder. -->
    <ItemGroup>
        <ProjectReference Include="$(OblivionModRoot)OblivionMp.Sdk.Serverside\OblivionMp.Sdk.Serverside.csproj" />
        <ProjectReference Include="$(CoreSdkSrc)ReadyM.Relay.Server.Sdk\ReadyM.Relay.Server.Sdk.csproj" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Roleplay.HungerAndThirst.Common\Roleplay.HungerAndThirst.Common.csproj" />
    </ItemGroup>

    <!-- The tests load a save file without the SDK starting the service. -->
    <ItemGroup>
        <InternalsVisibleTo Include="Roleplay.HungerAndThirst.Tests" />
    </ItemGroup>

</Project>
