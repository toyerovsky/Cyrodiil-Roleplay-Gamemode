  // ReadyM account ids (the admin panel's Players view) holding every permission.
  "owners": [],

  "startingGold": 50,

  // Game units, roughly centimetres.
  "chat": {
    "say": 1500,
    "shout": 4000,
    "whisper": 300,
    "emote": 1500
  },

  // Minutes a player stands still, does not turn and does not write before their name shows [AFK].
  "away": {
    "afterMinutes": 5
  },

  // The most gold one trade or /agold moves.
  "economy": {
    "maxPayment": 100000
  },

  // The gold a founder pays from what they carry. 0 founds for free.
  "factions": {
    "foundingFee": 500
  },

  // The gold each horse costs at a stablemaster, as the game's own stables ask. 0 gives it away.
  "stable": {
    "paint": 500,
    "bay": 1000,
    "chestnut": 2500,
    "white": 4000,
    "black": 5000
  },

  // Specializations taught by mentors and the registrar. The first choice costs firstPrice, a change changePrice once
  // changeCooldownSeconds (real seconds) passed since the last choice: 30 in a Debug build and 60 in a Release one when
  // it is left out, as here; a live server sets its own (259200 is three days). A specialization's own stats grow to 100, its trained
  // ones stop at the trained caps and the rest at the limited ones. A character who has not chosen yet stops at
  // unchosenSkillCap in every skill. potions: which potions fortify only a specialization's own stats (PlayerMade, All
  // or Off).
  "specializations": {
    "firstPrice": 0,
    "changePrice": 1000,
    "trainedSkillCap": 60,
    "limitedSkillCap": 30,
    "trainedAttributeCap": 75,
    "limitedAttributeCap": 50,
    "unchosenSkillCap": 50,
    "potions": "PlayerMade"
  },

  // Notice boards: the notices a board holds (a new one on a full board takes the oldest down), a notice's length, the
  // notices one character has up at once, the minutes between two of them, the days one stays up, and the game's form
  // whose mesh stands for a board.
  "noticeBoards": {
    "shown": 10,
    "minLength": 1,
    "maxLength": 300,
    "perCharacter": 3,
    "cooldownMinutes": 5,
    "expiryDays": 7,
    "asset": "/Game/Forms/worldobjects/activator/sign02.sign02"
  },
  "gambling": {
    "minStake": 1,
    "maxStake": 500,
    "cutPercent": 0,
    "tableReach": 300,
    "gamesPerTable": 2,
    "inviteSeconds": 30,
    "decisionSeconds": 45,
    "pokerRoundsToWin": 2,
    "maxReplays": 3
  },
  "auction": {
    "listingFeePercent": 2,
    "cutPercent": 5,
    "durationHours": [12, 24, 48],
    "maxLots": 10,
    "bidStepPercent": 5,
    "extendMinutes": 5
  },

